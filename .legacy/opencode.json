{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/plan.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
